generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Ver docs/MODELO_DATOS.md para el diagrama y la explicación de cada tabla.
// Reglas: cantidades Int (cajas o packs), dinero Decimal, fechas de operación = fecha simulada (@db.Date).

enum TipoAlmacen {
  PLANTA
  TRANSITO
}

enum ClaseAbc {
  A
  B
  C
}

enum EstadoCapa {
  DISPONIBLE
  CUARENTENA
  AGOTADA
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  RESERVA
  LIBERACION_RESERVA
  TRASLADO_SALIDA
  TRASLADO_ENTRADA
  AJUSTE
  MERMA
  CONTEO
  CUARENTENA
  ENVASE_ENTREGA
  ENVASE_DEVOLUCION
  BONIFICACION
}

enum EstadoPedido {
  PENDIENTE_REVISION
  CONFIRMADO
  DESPACHADO
  CANCELADO
}

enum EstadoTraslado {
  EMITIDA
  EN_TRANSITO
  RECIBIDA
  CON_DIFERENCIA
}

enum EstadoRecepcion {
  CONFORME
  DANADO
}

enum TipoConteo {
  CICLICO
  GENERAL
}

enum MotivoAjuste {
  ROTURA
  VENCIMIENTO
  DIFERENCIA_CONTEO
  PERDIDA_ROBO
  ERROR_REGISTRO
  PROMOCION
  // Faltante al recibir un traslado: queda en el tránsito hasta que R07 decida.
  DIFERENCIA_RECEPCION
}

enum EstadoAjuste {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoPromocion {
  DESCUENTO_FESTIVO
  BONIFICACION
  LIQUIDACION_VENCIMIENTO
  ROTACION_EXCESO
}

enum EstadoPromocion {
  PROPUESTA
  BORRADOR
  ACTIVA
  FINALIZADA
  RECHAZADA
}

enum ColorAlerta {
  AMARILLO
  ROJO
  AZUL
}

enum EstadoAlerta {
  ABIERTA
  ATENDIDA
  RESUELTA
}

enum TipoHistorialAlerta {
  CREADA
  CAMBIO_COLOR
  ATENDIDA
  ESCALADA
  RESUELTA
}

enum EstadoEventoIntegracion {
  REINTENTO
  COLA_ERRORES
  PROCESADO
}

// ---------- Maestros ----------

model Almacen {
  id                Int         @id @default(autoincrement())
  codigo            String      @unique
  nombre            String
  tipo              TipoAlmacen @default(PLANTA)
  leadTimeDias      Int         @default(0)
  // Almacén de tránsito (TR-xx) donde esperan los traslados que vienen hacia este almacén.
  almacenTransitoId Int?        @unique
  almacenTransito   Almacen?    @relation("TransitoDeAlmacen", fields: [almacenTransitoId], references: [id])
  almacenDestino    Almacen?    @relation("TransitoDeAlmacen")

  ubicaciones      Ubicacion[]
  parametros       ParametroArticuloAlmacen[]
  capas            CapaFifo[]
  movimientos      Movimiento[]
  pedidos          PedidoSimulado[]
  trasladosOrigen  OrdenTraslado[]            @relation("OrigenTraslado")
  trasladosDestino OrdenTraslado[]            @relation("DestinoTraslado")
  conteos          ConteoFisico[]
  ajustes          AjusteInventario[]
  saldosEnvase     SaldoEnvase[]
  promociones      Promocion[]
  alertas          Alerta[]
  usuarios         Usuario[]
}

model Ubicacion {
  id          Int     @id @default(autoincrement())
  almacenId   Int
  almacen     Almacen @relation(fields: [almacenId], references: [id])
  codigo      String
  descripcion String
  // CUAR-01 y la ubicación del tránsito no son vendibles.
  vendible    Boolean @default(true)

  capas       CapaFifo[]
  movimientos Movimiento[]
  conteos     ConteoFisico[]
  ajustes     AjusteInventario[]

  @@unique([almacenId, codigo])
}

model Articulo {
  id               Int     @id @default(autoincrement())
  codigo           String  @unique
  descripcion      String
  familia          String
  unidad           String
  precio           Decimal @db.Decimal(12, 2)
  vidaUtilDias     Int
  costoFifoInicial Decimal @db.Decimal(12, 4)
  esRetornable     Boolean @default(false)

  parametros     ParametroArticuloAlmacen[]
  capas          CapaFifo[]
  movimientos    Movimiento[]
  lineasPedido   LineaPedido[]
  lineasTraslado LineaTraslado[]
  conteos        ConteoFisico[]
  ajustes        AjusteInventario[]
  saldosEnvase   SaldoEnvase[]
  promociones    Promocion[]
  alertas        Alerta[]
}

// Entradas (d, σd, clase, Z) + valores calculados con src/inventario/calculos (SS, ROP, Q, Máx).
model ParametroArticuloAlmacen {
  id                Int       @id @default(autoincrement())
  articuloId        Int
  articulo          Articulo  @relation(fields: [articuloId], references: [id])
  almacenId         Int
  almacen           Almacen   @relation(fields: [almacenId], references: [id])
  demandaDiaria     Int
  desviacionDemanda Float
  leadTimeDias      Int
  claseAbc          ClaseAbc
  nivelServicio     Float
  z                 Float
  diasRevision      Int
  stockSeguridad    Int
  rop               Int
  loteTraslado      Int
  stockMaximo       Int
  ultimoConteo      DateTime? @db.Date

  @@unique([articuloId, almacenId])
}

model Rol {
  codigo      String    @id
  nombre      String
  descripcion String
  usuarios    Usuario[]
}

model Usuario {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nombre    String
  rolCodigo String
  rol       Rol      @relation(fields: [rolCodigo], references: [codigo])
  almacenId Int?
  almacen   Almacen? @relation(fields: [almacenId], references: [id])

  movimientos           Movimiento[]
  pedidos               PedidoSimulado[]
  traslados             OrdenTraslado[]
  conteos               ConteoFisico[]
  ajustesRegistrados    AjusteInventario[] @relation("AjusteRegistradoPor")
  ajustesAprobados      AjusteInventario[] @relation("AjusteAprobadoPor")
  alertasAtendidas      Alerta[]
  historialAlertas      HistorialAlerta[]
  promocionesPropuestas Promocion[]        @relation("PromocionPropuestaPor")
  promocionesAprobadas  Promocion[]        @relation("PromocionAprobadaPor")
  promocionesRechazadas Promocion[]        @relation("PromocionRechazadaPor")
  registrosCambio       RegistroCambio[]
}

model Cliente {
  id           Int              @id @default(autoincrement())
  codigo       String           @unique
  nombre       String
  pedidos      PedidoSimulado[]
  saldosEnvase SaldoEnvase[]
}

// ---------- Inventario ----------

model CapaFifo {
  id               Int            @id @default(autoincrement())
  articuloId       Int
  articulo         Articulo       @relation(fields: [articuloId], references: [id])
  almacenId        Int
  almacen          Almacen        @relation(fields: [almacenId], references: [id])
  ubicacionId      Int
  ubicacion        Ubicacion      @relation(fields: [ubicacionId], references: [id])
  lote             String
  fechaEntrada     DateTime       @db.Date
  fechaElaboracion DateTime       @db.Date
  fechaVencimiento DateTime       @db.Date
  cantidadInicial  Int
  cantidadRestante Int
  costoUnitario    Decimal        @db.Decimal(12, 4)
  estado           EstadoCapa     @default(DISPONIBLE)
  // Solo en capas del almacén de tránsito: el traslado al que pertenecen.
  ordenTrasladoId  Int?
  ordenTraslado    OrdenTraslado? @relation(fields: [ordenTrasladoId], references: [id])

  movimientos Movimiento[]
  promociones Promocion[]
  ajustes     AjusteInventario[]

  // Orden FIFO: por fechaEntrada y luego id.
  @@index([articuloId, almacenId, estado, fechaEntrada])
}

// Libro mayor inmutable: un trigger en la base impide UPDATE y DELETE.
model Movimiento {
  id             Int            @id @default(autoincrement())
  tipo           TipoMovimiento
  articuloId     Int
  articulo       Articulo       @relation(fields: [articuloId], references: [id])
  almacenId      Int
  almacen        Almacen        @relation(fields: [almacenId], references: [id])
  ubicacionId    Int
  ubicacion      Ubicacion      @relation(fields: [ubicacionId], references: [id])
  capaId         Int?
  capa           CapaFifo?      @relation(fields: [capaId], references: [id])
  // Con signo: + entra al almacén, − sale. RESERVA, CONTEO, CUARENTENA y ENVASE_* no cambian el stock físico.
  cantidad       Int
  costoUnitario  Decimal        @db.Decimal(12, 4)
  valor          Decimal        @db.Decimal(14, 2)
  fechaOperacion DateTime       @db.Date
  creadoEn       DateTime       @default(now())
  usuarioId      Int
  usuario        Usuario        @relation(fields: [usuarioId], references: [id])
  motivo         String
  documentoTipo  String?
  documentoId    Int?

  @@index([articuloId, almacenId, fechaOperacion])
  @@index([capaId])
}

model PedidoSimulado {
  id             Int           @id @default(autoincrement())
  numero         String        @unique
  clienteId      Int
  cliente        Cliente       @relation(fields: [clienteId], references: [id])
  almacenId      Int
  almacen        Almacen       @relation(fields: [almacenId], references: [id])
  estado         EstadoPedido
  fechaOperacion DateTime      @db.Date
  fechaDespacho  DateTime?     @db.Date
  // Al crearse no alcanzó el stock (costo de agotamiento), aunque luego se cancele.
  conFaltante    Boolean       @default(false)
  creadoEn       DateTime      @default(now())
  usuarioId      Int
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])
  lineas         LineaPedido[]

  @@index([almacenId, estado])
}

model LineaPedido {
  id           Int            @id @default(autoincrement())
  pedidoId     Int
  pedido       PedidoSimulado @relation(fields: [pedidoId], references: [id])
  articuloId   Int
  articulo     Articulo       @relation(fields: [articuloId], references: [id])
  cantidad     Int
  // Bonificación en especie: sin cargo, ligada a una promoción BONIFICACION vigente.
  bonificacion Boolean        @default(false)
  promocionId  Int?
  promocion    Promocion?     @relation(fields: [promocionId], references: [id])
}

model OrdenTraslado {
  id              Int                @id @default(autoincrement())
  numero          String             @unique
  origenId        Int
  origen          Almacen            @relation("OrigenTraslado", fields: [origenId], references: [id])
  destinoId       Int
  destino         Almacen            @relation("DestinoTraslado", fields: [destinoId], references: [id])
  estado          EstadoTraslado
  fechaEmision    DateTime           @db.Date
  fechaDespacho   DateTime?          @db.Date
  fechaRecepcion  DateTime?          @db.Date
  usuarioId       Int
  usuario         Usuario            @relation(fields: [usuarioId], references: [id])
  lineas          LineaTraslado[]
  capasEnTransito CapaFifo[]
  ajustes         AjusteInventario[]

  @@index([estado])
}

model LineaTraslado {
  id                 Int              @id @default(autoincrement())
  ordenId            Int
  orden              OrdenTraslado    @relation(fields: [ordenId], references: [id])
  articuloId         Int
  articulo           Articulo         @relation(fields: [articuloId], references: [id])
  cantidadDespachada Int
  cantidadRecibida   Int?
  estadoRecepcion    EstadoRecepcion?
  observacion        String?
}

model ConteoFisico {
  id               Int                @id @default(autoincrement())
  tipo             TipoConteo
  articuloId       Int
  articulo         Articulo           @relation(fields: [articuloId], references: [id])
  almacenId        Int
  almacen          Almacen            @relation(fields: [almacenId], references: [id])
  ubicacionId      Int
  ubicacion        Ubicacion          @relation(fields: [ubicacionId], references: [id])
  cantidadSistema  Int
  cantidadContada  Int
  diferencia       Int
  porcentaje       Float
  // Diferencia mayor que la tolerancia (ConfiguracionSistema.toleranciaConteoPct).
  requiereRecuento Boolean            @default(false)
  usuarioId        Int
  usuario          Usuario            @relation(fields: [usuarioId], references: [id])
  fechaOperacion   DateTime           @db.Date
  creadoEn         DateTime           @default(now())
  ajustes          AjusteInventario[]

  @@index([articuloId, almacenId, fechaOperacion])
}

model AjusteInventario {
  id                   Int            @id @default(autoincrement())
  articuloId           Int
  articulo             Articulo       @relation(fields: [articuloId], references: [id])
  almacenId            Int
  almacen              Almacen        @relation(fields: [almacenId], references: [id])
  ubicacionId          Int
  ubicacion            Ubicacion      @relation(fields: [ubicacionId], references: [id])
  motivo               MotivoAjuste
  // Con signo: negativo = baja de stock.
  cantidad             Int
  observacion          String?
  estado               EstadoAjuste   @default(PENDIENTE)
  conteoId             Int?
  conteo               ConteoFisico?  @relation(fields: [conteoId], references: [id])
  // Capa afectada (opcional): si no se indica, una baja consume FIFO.
  capaId               Int?
  capa                 CapaFifo?      @relation(fields: [capaId], references: [id])
  // DIFERENCIA_RECEPCION: traslado cuya diferencia sigue en el tránsito.
  ordenTrasladoId      Int?
  ordenTraslado        OrdenTraslado? @relation(fields: [ordenTrasladoId], references: [id])
  registradoPorId      Int
  registradoPor        Usuario        @relation("AjusteRegistradoPor", fields: [registradoPorId], references: [id])
  fechaRegistro        DateTime       @db.Date
  registradoEn         DateTime       @default(now())
  aprobadoPorId        Int?
  aprobadoPor          Usuario?       @relation("AjusteAprobadoPor", fields: [aprobadoPorId], references: [id])
  // Comentario de R07 al aprobar o rechazar (obligatorio al rechazar).
  comentarioResolucion String?
  fechaResolucion      DateTime?      @db.Date

  @@index([estado])
}

model SaldoEnvase {
  id                Int      @id @default(autoincrement())
  clienteId         Int
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  articuloId        Int
  articulo          Articulo @relation(fields: [articuloId], references: [id])
  almacenId         Int
  almacen           Almacen  @relation(fields: [almacenId], references: [id])
  cantidadEntregada Int
  cantidadDevuelta  Int      @default(0)
  fechaEntrega      DateTime @db.Date

  @@index([clienteId, articuloId])
}

// ---------- Comercial (solo datos) ----------

model Promocion {
  id                   Int             @id @default(autoincrement())
  nombre               String
  tipo                 TipoPromocion
  articuloId           Int
  articulo             Articulo        @relation(fields: [articuloId], references: [id])
  almacenId            Int?
  almacen              Almacen?        @relation(fields: [almacenId], references: [id])
  // Liquidación por vencimiento: aplica solo a esta capa.
  capaId               Int?
  capa                 CapaFifo?       @relation(fields: [capaId], references: [id])
  fechaInicio          DateTime        @db.Date
  fechaFin             DateTime        @db.Date
  topeCajas            Int
  cajasUsadas          Int             @default(0)
  descuentoPct         Float?
  estado               EstadoPromocion
  // Aprobación de R07 con el identificador del correo del Gerente de Logística y Ventas.
  referenciaCorreo     String?
  propuestaPorId       Int?
  propuestaPor         Usuario?        @relation("PromocionPropuestaPor", fields: [propuestaPorId], references: [id])
  aprobadoPorId        Int?
  aprobadoPor          Usuario?        @relation("PromocionAprobadaPor", fields: [aprobadoPorId], references: [id])
  // Rechazo de R07 (comentario obligatorio).
  comentarioResolucion String?
  rechazadaPorId       Int?
  rechazadaPor         Usuario?        @relation("PromocionRechazadaPor", fields: [rechazadaPorId], references: [id])
  lineasPedido         LineaPedido[]
}

model Fiesta {
  id                 Int      @id @default(autoincrement())
  nombre             String
  fechaInicio        DateTime @db.Date
  fechaFin           DateTime @db.Date
  // Días festivos reales (p. ej. 16/07 y 06/08 son 2 días aunque el rango sea más largo).
  diasFiesta         Int
  // Códigos de los almacenes de la zona.
  zonas              String[]
  factor             Float
  semanasPreparacion Int
}

// ---------- Alertas y sistema ----------

// Ver docs/ALERTAS.md. Una sola alerta abierta (ABIERTA o ATENDIDA) por clave: índice único parcial en la migración.
model Alerta {
  id                Int               @id @default(autoincrement())
  // codigo|almacén|artículo|referencia
  clave             String
  codigo            String
  color             ColorAlerta
  // Nulo solo en alertas de sistema (AL16).
  almacenId         Int?
  almacen           Almacen?          @relation(fields: [almacenId], references: [id])
  articuloId        Int?
  articulo          Articulo?         @relation(fields: [articuloId], references: [id])
  referenciaTipo    String
  referenciaId      Int?
  mensaje           String
  rolesResponsables String[]
  accionSugerida    String
  datos             Json
  estado            EstadoAlerta      @default(ABIERTA)
  // Fecha simulada de creación y del color actual (desde ahí se mide el escalamiento).
  fechaOperacion    DateTime          @db.Date
  fechaColor        DateTime          @db.Date
  // 0 responsable, 1 R07, 2 Gerente de Logística y Ventas.
  nivelEscalamiento Int               @default(0)
  creadaEn          DateTime          @default(now())
  atendidaPorId     Int?
  atendidaPor       Usuario?          @relation(fields: [atendidaPorId], references: [id])
  atendidaEn        DateTime?
  fechaAtencion     DateTime?         @db.Date
  resultado         String?
  comentario        String?
  fechaResolucion   DateTime?         @db.Date
  historial         HistorialAlerta[]

  @@index([estado, almacenId])
  @@index([clave])
}

model HistorialAlerta {
  id             Int                 @id @default(autoincrement())
  alertaId       Int
  alerta         Alerta              @relation(fields: [alertaId], references: [id])
  tipo           TipoHistorialAlerta
  colorAnterior  ColorAlerta?
  colorNuevo     ColorAlerta?
  nivel          Int?
  detalle        String?
  usuarioId      Int?
  usuario        Usuario?            @relation(fields: [usuarioId], references: [id])
  fechaOperacion DateTime            @db.Date
  creadoEn       DateTime            @default(now())
}

// Eventos simulados para AL16 (falla de integración o conciliación).
model EventoIntegracion {
  id             Int                     @id @default(autoincrement())
  tipo           String
  referencia     String
  estado         EstadoEventoIntegracion
  intentos       Int                     @default(1)
  fechaOperacion DateTime                @db.Date
  creadoEn       DateTime                @default(now())
  procesadoEn    DateTime?
}

model ConfiguracionSistema {
  clave         String   @id
  valor         Json
  descripcion   String
  actualizadoEn DateTime @updatedAt
}

model RegistroCambio {
  id             Int       @id @default(autoincrement())
  usuarioId      Int?
  usuario        Usuario?  @relation(fields: [usuarioId], references: [id])
  entidad        String
  entidadId      String
  campo          String
  valorAnterior  Json?
  valorNuevo     Json?
  fechaOperacion DateTime? @db.Date
  creadoEn       DateTime  @default(now())
}
