POSTGRES_USER=inventario
POSTGRES_PASSWORD=inventario123
POSTGRES_DB=inventario_cbn
POSTGRES_PORT=5432
DATABASE_URL=postgresql://inventario:inventario123@localhost:5432/inventario_cbn?schema=public

# Herramientas de demo (restablecer datos desde la interfaz). Desactívalo fuera de una demo.
DEMO_MODE=true

# Opcionales (los valores por defecto sirven para la demo):
# PORT=3000                                   puerto del backend
# DATABASE_URL_TEST=postgresql://...          base de los tests de integración (por defecto, inventario_test en el mismo contenedor)
# API_URL=http://localhost:3000/api           backend que usan npm run demo:api y demo:alertas
# VITE_API_URL=http://localhost:3000/api      backend que usa el frontend (se lee al compilar)
# DEMO_SIN_ABRIR=1                            npm run demo:iniciar no abre el navegador
# CHROMIUM_PATH=/ruta/al/chromium             Chromium para Playwright si no está en la caché
